typeattribute hal_power_default mlstrustedsubject;

type vendor_touchfeature_device, dev_type;

allow hal_power_default vendor_touchfeature_device:chr_file rw_file_perms;

allow hal_power_default vendor_sysfs_kgsl:lnk_file rw_file_perms;

allow hal_power_default {
  vendor_sysfs_devfreq
  vendor_sysfs_msm_subsys
}:dir search;

allow hal_power_default {
  input_device
  vendor_latency_device
}:chr_file rw_file_perms;

allow hal_power_default {
  cgroup
  proc
  sysfs_devices_system_cpu
  vendor_sysfs_graphics
  vendor_sysfs_devfreq
  vendor_sysfs_kgsl
  vendor_sysfs_scsi_host
}:{
  file
  lnk_file
} rw_file_perms;

allow hal_power_default {
  cgroup
  input_device
  vendor_sysfs_devfreq
}:dir r_dir_perms;


# Rule for hal_power_default to access graphics composer process
unix_socket_connect(hal_power_default, vendor_pps, hal_graphics_composer_default);

# To get/set powerhal state propert
set_prop(hal_power_default, vendor_power_prop)

allow hal_power_default self:capability { sys_nice };

# Optional: if the HAL also tries to set CPU affinity or other sched tasks
allow hal_power_default kernel:process setsched;
allow hal_power_default self:process setsched;

# Allow Power HAL to boost priority for other processes (like SystemUI and apps)
# This is what triggered the { setsched } denial
allow hal_power_default domain:process { setsched };

# Specifically for apps (if domain is too broad for neverallows)
allow hal_power_default platform_app:process { setsched };
allow hal_power_default untrusted_app:process { setsched };
allow hal_power_default priv_app:process { setsched };
allow hal_power_default system_app:process { setsched };
allow hal_power_default untrusted_app:process { setsched };


